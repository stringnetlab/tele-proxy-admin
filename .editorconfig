root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.latte]
indent_size = 4

[*.{js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

[docker/**]
end_of_line = lf

[Makefile]
indent_style = tab
