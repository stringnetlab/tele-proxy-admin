{block content}
<div class="page-header">
	<h2>Nuevo administrador</h2>
</div>

<div class="form-container">
	{form adminForm}
		<p class="muted">
			El dominio del email debe estar entre los permitidos por el servidor.
			El administrador se crea activo y con rol <code>admin</code>.
		</p>

		<div class="form-group">
			{label email}Email{/label}
			{input email}
		</div>

		{input errors}

		<div class="form-actions">
			{input save class => 'btn btn-primary'}
			<a href="{plink list}" class="btn btn-secondary">Cancelar</a>
		</div>
	{/form}
</div>
{/block}
