{block content}
<div class="page-header">
	<h2>Nuevo administrador</h2>
</div>

<div class="form-container">
	<form n:name="adminForm">
		<div class="form-group">
			<label n:name="email">Email</label>
			<input n:name="email" class="form-control" type="email">
		</div>

		<div class="form-group">
			<label n:name="role">Rol</label>
			<select n:name="role" class="form-control">
				<option value="admin">Admin</option>
				<option value="master">Master</option>
			</select>
		</div>

		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Crear administrador</button>
			<a href="{plink list}" class="btn btn-secondary">Cancelar</a>
		</div>
	</form>
</div>
{/block}
