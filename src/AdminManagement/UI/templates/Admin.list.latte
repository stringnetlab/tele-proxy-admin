{block content}
<div class="page-header">
	<h2>Administradores</h2>
	<div class="actions">
		<a href="{plink create}" class="btn btn-primary">Nuevo administrador</a>
	</div>
</div>

<div class="table-container">
	<table class="table">
		<thead>
			<tr>
				<th>Email</th>
				<th>Rol</th>
				<th>Estado</th>
				<th>Creado</th>
				<th>Creado por</th>
				<th>Acciones</th>
			</tr>
		</thead>
		<tbody>
			{foreach $admins as $admin}
				<tr>
					<td>
						{$admin->email}
						{if $admin->email === $currentEmail}<span class="badge badge-active">tú</span>{/if}
					</td>
					<td><span class="badge badge-{$admin->role}">{$admin->role}</span></td>
					<td>
						{if $admin->active}
							<span class="badge badge-active">Activo</span>
						{else}
							<span class="badge badge-inactive">Inactivo</span>
						{/if}
					</td>
					<td>{$admin->createdAt->format('Y-m-d H:i')}</td>
					<td>{if $admin->createdBy !== ''}{$admin->createdBy}{else}&mdash;{/if}</td>
					<td class="actions">
						<a href="{plink detail, email => $admin->email}" class="btn btn-sm">Abrir</a>
					</td>
				</tr>
			{else}
				<tr>
					<td colspan="6">No hay administradores.</td>
				</tr>
			{/foreach}
		</tbody>
	</table>
</div>
{/block}
