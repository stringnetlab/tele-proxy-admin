{block content}
<div class="page-header">
	<h2>Administrador: {$admin->email}</h2>
	<div class="actions">
		<a href="{plink list}" class="btn btn-secondary">Volver</a>
	</div>
</div>

<div class="detail-card">
	<div class="detail-row">
		<label>Email:</label>
		<span>{$admin->email}</span>
	</div>
	<div class="detail-row">
		<label>Rol:</label>
		<span><span class="badge badge-{$admin->role}">{$admin->role}</span></span>
	</div>
	<div class="detail-row">
		<label>Estado:</label>
		<span>
			{if $admin->active}
				<span class="badge badge-active">Activo</span>
			{else}
				<span class="badge badge-inactive">Inactivo</span>
			{/if}
		</span>
	</div>
	<div class="detail-row">
		<label>Creado:</label>
		<span>{$admin->createdAt->format('Y-m-d H:i:s')}</span>
	</div>
	<div class="detail-row">
		<label>Creado por:</label>
		<span>{if $admin->createdBy !== ''}{$admin->createdBy}{else}&mdash;{/if}</span>
	</div>
</div>

{if $admin->email !== $currentEmail}
	<div class="detail-card actions-card">
		<h3>Acciones</h3>
		<p class="muted">Desactivar impide el login de esta cuenta. Eliminar es irreversible.</p>

		{form actionsForm}
			{input errors}
			<div class="form-actions">
				{input toggle}
				{input delete}
			</div>
		{/form}
	</div>
{else}
	<p class="muted">No puedes desactivar ni eliminar tu propia cuenta.</p>
{/if}
{/block}
