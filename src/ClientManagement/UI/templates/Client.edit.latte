{block content}
<div class="page-header">
	<h2>Editar cliente: {$client->name}</h2>
</div>

<div class="form-container">
	<form n:name="clientForm">
		<input type="hidden" name="config_version" value="{$client->configVersion}">

		<div class="form-group">
			<label n:name="name">Nombre</label>
			<input n:name="name" class="form-control">
		</div>

		<div class="form-group">
			<label n:name="domain">Dominio</label>
			<input n:name="domain" class="form-control">
		</div>

		<div class="form-group">
			<label n:name="whitelist">Whitelist (un dominio por línea)</label>
			<textarea n:name="whitelist" class="form-control" rows="5"></textarea>
		</div>

		<div class="form-row">
			<div class="form-group">
				<label n:name="rate_limit_requests">Rate limit (peticiones)</label>
				<input n:name="rate_limit_requests" class="form-control" type="number">
			</div>

			<div class="form-group">
				<label n:name="rate_limit_window">Ventana (segundos)</label>
				<input n:name="rate_limit_window" class="form-control" type="number">
			</div>
		</div>

		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Guardar cambios</button>
			<a href="{plink detail, id => $client->cryptId}" class="btn btn-secondary">Cancelar</a>
		</div>
	</form>
</div>
{/block}
