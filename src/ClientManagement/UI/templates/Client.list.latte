{block content}
<div class="page-header">
	<h2>Clientes</h2>
	<div class="actions">
		<a href="{plink create}" class="btn btn-primary">Nuevo cliente</a>
		<a href="{plink export}" class="btn btn-secondary">Exportar</a>
	</div>
</div>

<div class="table-container">
	<table id="clients-table" class="table">
		<thead>
			<tr>
				<th>Crypt ID</th>
				<th>Nombre</th>
				<th>Dominio</th>
				<th>Rate Limit</th>
				<th>Acciones</th>
			</tr>
		</thead>
		<tbody>
			{foreach $clients as $client}
			<tr>
				<td><code>{$client['crypt_id']}</code></td>
				<td>{$client['name']}</td>
				<td>{$client['domain']}</td>
				<td>{$client['rate_limit']['max_requests'] ?? 50}/{$client['rate_limit']['window_seconds'] ?? 60}s</td>
				<td class="actions">
					<a href="{plink detail, id => $client['crypt_id']}" class="btn btn-sm">Ver</a>
					<a href="{plink edit, id => $client['crypt_id']}" class="btn btn-sm">Editar</a>
					<a href="{plink delete, id => $client['crypt_id']}" class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar este cliente?')">Eliminar</a>
				</td>
			</tr>
			{/foreach}
		</tbody>
	</table>
</div>

{if $total > 20}
<div class="pagination">
	{if $page > 1}
		<a href="{plink list, page => $page - 1}" class="btn btn-sm">&laquo; Anterior</a>
	{/if}
	<span class="page-info">Página {$page} de {ceil($total / 20)}</span>
	{if $page < ceil($total / 20)}
		<a href="{plink list, page => $page + 1}" class="btn btn-sm">Siguiente &raquo;</a>
	{/if}
</div>
{/if}
{/block}
