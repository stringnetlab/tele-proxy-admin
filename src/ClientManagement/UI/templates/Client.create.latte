{block content}
<div class="page-header">
	<h2>Nuevo cliente</h2>
</div>

<div class="form-container">
	{form createForm}
		<div class="form-group">
			<label>{input wildcard} Salida libre (wildcard)</label>
			<small class="muted">Salta la whitelist. El anti-SSRF de IP sigue aplicando.</small>
		</div>

		{input errors}

		<div class="form-actions">
			{input create class => 'btn btn-primary'}
			<a href="{plink list}" class="btn btn-secondary">Cancelar</a>
		</div>
	{/form}
</div>
{/block}
