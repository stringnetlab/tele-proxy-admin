parameters:

application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping:
		Authentication: [App\Authentication\UI, '', *Presenter]
		ClientManagement: [App\ClientManagement\UI, '', *Presenter]
		AdminManagement: [App\AdminManagement\UI, '', *Presenter]
		SettingsManagement: [App\SettingsManagement\UI, '', *Presenter]

session:
	autoStart: false
	name: __Host-teleproxy_admin_ui
	cookieSecure: true
	cookieHttponly: true
	cookieSamesite: Lax
	expiration: 15 minutes
	savePath: %tempDir%

latte:
	strictParsing: yes
	extensions:
		- App\Presentation\Accessory\LatteExtension

di:
	export:
		parameters: no
		tags: no

http:
	headers:
		X-Content-Type-Options: nosniff
		X-Frame-Options: DENY
		Referrer-Policy: strict-origin-when-cross-origin
