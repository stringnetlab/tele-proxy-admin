# Los parametros (%apiUrl%, %couchDbUrl%, ...) los inyecta App\Bootstrap desde las variables de entorno,
# con sus valores por defecto. Neon no resuelve %env.X%.
services:
	- App\Core\RouterFactory::createRouter

	# Shared Infrastructure
	shared.apiClient:
		type: App\Shared\Infrastructure\ApiClient
		arguments:
			apiUrl: %apiUrl%

	shared.couchDbConnection:
		type: App\Shared\Infrastructure\CouchDbConnection
		arguments:
			couchDbUrl: %couchDbUrl%
			database: %couchDbDatabase%

	shared.valkeyConnection:
		type: App\Shared\Infrastructure\ValkeyConnection
		arguments:
			valkeyUrl: %valkeyDsn%

	shared.rateLimiter:
		type: App\Shared\Infrastructure\RateLimiter
		arguments:
			valkey: @shared.valkeyConnection

	shared.apiCookieCipher:
		type: App\Shared\Infrastructure\ApiCookieCipher
		arguments:
			secret: %sessionSecret%

	shared.clientIpResolver:
		type: App\Shared\Infrastructure\ClientIpResolver
		arguments:
			trustedProxies: %trustedProxies%

	shared.apiSession:
		type: App\Shared\Infrastructure\ApiSession

	shared.tokenVault:
		type: App\Shared\Infrastructure\TokenVault
		arguments:
			valkey: @shared.valkeyConnection

	# Authentication
	auth.sessionRepository:
		type: App\Authentication\Infrastructure\CouchDbSessionRepository
		arguments:
			connection: @shared.couchDbConnection

	auth.singleSessionStore:
		type: App\Authentication\Infrastructure\ValkeySingleSessionStore
		arguments:
			valkey: @shared.valkeyConnection

	auth.apiAuthAdapter:
		type: App\Authentication\Infrastructure\ApiAuthAdapter
		arguments:
			apiClient: @shared.apiClient

	auth.loginRateLimiter:
		type: App\Authentication\Application\LoginRateLimiter
		arguments:
			limiter: @shared.rateLimiter
			clientIpResolver: @shared.clientIpResolver
			maxRequests: %loginRateLimitRequests%
			windowSeconds: %loginRateLimitWindowSeconds%

	# Client Management
	client.repository:
		type: App\ClientManagement\Infrastructure\ApiClientRepository
		arguments:
			apiClient: @shared.apiClient
			apiSession: @shared.apiSession

	# Admin Management
	admin.repository:
		type: App\AdminManagement\Infrastructure\ApiAdminRepository
		arguments:
			apiClient: @shared.apiClient
			apiSession: @shared.apiSession

	# Settings Management
	settings.repository:
		type: App\SettingsManagement\Infrastructure\ApiSettingsRepository
		arguments:
			apiClient: @shared.apiClient
			apiSession: @shared.apiSession

search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
			- *Presenter
	-	in: %appDir%/../src
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
			- *Handler
			- *Store
			- *Adapter
			- *Presenter
