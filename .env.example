# ===========================================
# tele-proxy-admin — Variables de entorno
# ===========================================
# Copiar a .env y ajustar valores.
# NUNCA commitear .env con valores reales.

# API de control de tele-proxy (sin slash final)
PUBLIC_API_URL=https://apiteleproxy.velone.ai

# CouchDB (login, auth, logs)
COUCHDB_URL=http://couchdb:5984
COUCHDB_DATABASE=teleproxy_admin

# Valkey (cache, rate limiting, single session)
VALKEY_URL=redis://valkey:6379

# Secreto para firmar cookies Nette y cifrar la cookie del API en sesión
# (generar: openssl rand -hex 32)
SESSION_SECRET=

# Proxies de confianza (IPs o CIDR separados por coma) para resolver la IP real
# del cliente desde CF-Connecting-IP / X-Forwarded-For. Vacío = no confiar en cabeceras.
TRUSTED_PROXIES=

# Rate limit del flujo de login (peticiones por ventana y tamaño de la ventana)
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Zona horaria para mostrar timestamps
TZ_DISPLAY=America/Lima

# ===========================================
# Desarrollo local
# ===========================================
# PUBLIC_API_URL=http://localhost:8785
# ADMIN_UI_URL=http://localhost:5173
# COUCHDB_URL=http://localhost:5984
# VALKEY_URL=redis://localhost:6379
