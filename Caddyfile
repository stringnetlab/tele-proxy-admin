{
	{$CADDY_DOMAIN}

	root * /app/www
	php_server

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /_ok {
		php_fastcgi localhost:9000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle_errors {
		@403 expression `{http.error.status_code} == 403`
		@404 expression `{http.error.status_code} == 404`
		@5xx expression `{http.error.status_code} >= 500`

		rewrite @403 /Error/403
		rewrite @404 /Error/404
		rewrite @5xx /Error/500

		php_fastcgi localhost:9000
	}

	log {
		output stdout
		format json
		level INFO
	}
}
