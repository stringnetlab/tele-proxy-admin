{
    "name": "stringnetlab/tele-proxy-admin",
    "description": "Panel de administracion de tele-proxy. BFF Nette que reenvia al API de control.",
    "keywords": ["nette", "tele-proxy", "admin", "bff"],
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">= 8.3",
        "nette/application": "^3.2.3",
        "nette/bootstrap": "^3.2.6",
        "nette/caching": "^3.2",
        "nette/di": "^3.2",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/robot-loader": "^4.0",
        "nette/security": "^3.2",
        "nette/utils": "^4.0",
        "latte/latte": "^3.1",
        "tracy/tracy": "^2.10",
        "guzzlehttp/guzzle": "^7.8",
        "predis/predis": "^2.2",
        "guzzlehttp/promises": "^2.0"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "nette/phpstan-rules": "^1.0",
        "phpunit/phpunit": "^11.0",
        "behat/behat": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app",
            "App\\Shared\\": "src/Shared",
            "App\\Authentication\\": "src/Authentication",
            "App\\ClientManagement\\": "src/ClientManagement",
            "App\\AdminManagement\\": "src/AdminManagement"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "tester": "tester tests -s",
        "test": "tester tests -s",
        "bdd": "behat",
        "cs-fix": "php-cs-fixer fix",
        "audit": "composer audit --no-dev",
        "build": "composer install --no-dev --optimize-autoloader --no-interaction",
        "dev": "php -S localhost:8080 -t www"
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
